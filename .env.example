# .env.example: the settings this project needs, with FAKE values.
# This file is public. Copy it to a file called .env (which git ignores)
# and put your real values there. Never put a real key in this file.

ABUSEIPDB_API_KEY=your-key-here
VIRUSTOTAL_API_KEY=your-key-here
DISCORD_WEBHOOK_URL=your-webhook-url-here

# Your home IP address(es), so your own test logins are left out of the stats
MY_HOME_IPS=your-ip-here
